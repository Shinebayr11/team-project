# Copy to .env and fill in real values. .env is gitignored — never commit it.

# LiveKit Cloud dashboard -> Settings -> Keys
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://your-project.livekit.cloud

# MongoDB connection string (not wired into any route yet — see ARCHITECTURE.md §9)
MONGODB_URI=
