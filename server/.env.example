LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=
MONGODB_URI=
CLERK_SECRET_KEY=

# Хөтчөөс ШУУД ирэх cross-origin хүсэлтэд зөвшөөрөх домэйнууд, таслалаар
# тусгаарлана (жишээ нь https://whynot.mn,https://staging.whynot.mn).
# Тохируулаагүй бол зөвхөн http://localhost:3000 зөвшөөрөгдөнө.
# Next-ийн /api/* rewrite-аар дамжсан хүсэлт CORS-д хамаарахгүй тул
# энэ нь зөвхөн гар аргаар турших, өөр клиент холбоход хэрэгтэй.
CORS_ORIGINS=

# Wire — төлбөрийн систем (QPay оператороор). Нууц түлхүүр ЗӨВХӨН сервер дээр.
WIRE_SECRET_KEY=sk_live_...

# Wire-ийн webhook-ийн нууц. `POST /v1/webhook_endpoints` дээр
# https://<домэйн>/api/payment/webhook-ыг бүртгэхэд буцаж ирнэ.
# Тохируулаагүй бол webhook ЮУ Ч цэнэглэхгүй (баталгаажаагүй мэдээлэлд
# итгэхгүй) — гэхдээ цонхны төлөв шалгагч төлбөрийг барьж авна.
WIRE_WEBHOOK_SECRET=

# API-ийн хаяг. Зөвхөн Wire домэйноо солих үед л хэрэгтэй.
# WIRE_API_URL=https://api.wire.mn
